$$ byte_container_with_subtype_ctor -> container_type {
    1. Initialize container_type with std::move(b)
    2. Set m_subtype to subtype_
    3. Set m_has_subtype to true
}$$

$$ operator_eq -> byte_container_with_subtype {
    1. Compare static_cast<const BinaryType&>(*this) with static_cast<const BinaryType&>(rhs)
    2. Compare m_subtype with rhs.m_subtype
    3. Compare m_has_subtype with rhs.m_has_subtype
    4. Return true if all comparisons are equal, otherwise false
}$$

$$ operator_neq -> byte_container_with_subtype {
    1. Return !(rhs == *this)
}$$

$$ set_subtype -> byte_container_with_subtype {
    1. Set m_subtype to subtype_
    2. Set m_has_subtype to true
}$$

$$ subtype -> byte_container_with_subtype {
    1. Return m_subtype if m_has_subtype is true, otherwise return static_cast<subtype_type>(-1)
}$$

$$ has_subtype -> byte_container_with_subtype {
    1. Return m_has_subtype
}$$

$$ clear_subtype -> byte_container_with_subtype {
    1. Set m_subtype to 0
    2. Set m_has_subtype to false
}$$

$$ combine -> detail {
