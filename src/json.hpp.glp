}$$

$$ JsonPointerClass {
    1.  Constructor {
        Initialize reference_tokens vector.
    } $

    2.  AppendPointer {
        -> JsonPointerClass
        Append another JSON pointer to the current one.
        1. Insert new tokens at the end of reference_tokens.
    } $

    3.  AppendToken {
        -> JsonPointerClass
        Append an unescaped reference token to the current pointer.
        1. Push token to reference_tokens.
    } $

    4.  AppendArrayIndex {
        -> JsonPointerClass
        Append an array index to the current pointer.
        1. Convert index to string and append.
    } $

    5.  OperatorPlus {
        -> JsonPointerClass
        Create a new JSON pointer by appending another pointer.
        1. Combine reference_tokens of both pointers.
    } $

    6.  ParentPointer {
        -> JsonPointerClass
        Return the parent JSON pointer.
        1. Remove the last token from reference_tokens.
    } $

    7.  PopBack {
        -> JsonPointerClass
        Remove the last reference token.
        1. Check if pointer is not empty.
        2. Pop back from reference_tokens.
    } $

    8.  Back {
        -> JsonPointerClass
        Return the last reference token.
        1. Check if pointer is not empty.
        2. Return the last token.
    } $

    9.  PushBack {
        -> JsonPointerClass
        Append an unescaped token to the pointer.
        1. Push token to reference_tokens.
    } $

    10.  Empty {
        -> JsonPointerClass
        Check if the pointer is empty.
        1. Return true if reference_tokens is empty.
    } $

    11.  ArrayIndex {
        -> JsonPointerClass
        Convert a reference token to an array index.
        1. Validate token format.
        2. Convert token to integer.
    } $

    12.  Top {
        -> JsonPointerClass
        Return the top-level JSON pointer.
        1. Create a new pointer with the first token.
    } $

    13.  GetAndCreate {
        -> JsonPointerClass
        Get and create the pointed-to value.
        1. Traverse the JSON structure.
        2. Create missing objects or arrays.
    } $

    14.  GetUnchecked {
        -> JsonPointerClass
        Get the pointed-to value without checks.
        1. Traverse the JSON structure.
        2. Handle null values by converting to array/object.
    } $

    15.  GetChecked {
        -> JsonPointerClass
        Get the pointed-to value with checks.
        1. Traverse the JSON structure.
        2. Perform range checks.
    } $

    16.  Contains {
        -> JsonPointerClass
        Check if the pointer contains a value.
        1. Traverse the JSON structure.
        2. Validate each token.
    } $
}$$

$$ OperatorOutput {
    -> JsonPointerClass
    Output the JSON pointer to a stream.
    1. Output the string representation of the pointer.
