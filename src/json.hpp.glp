$$ CompilerVersionChecks {
    1. Check MSVC version using JSON_HEDLEY_MSVC_VERSION_CHECK
    2. Check Intel CL version using JSON_HEDLEY_INTEL_CL_VERSION_CHECK
    3. Check TI CL6X version and C++ mode using JSON_HEDLEY_TI_CL6X_VERSION_CHECK and defined(__cplusplus)
    4. Check CompCert version using JSON_HEDLEY_COMPCERT_VERSION_CHECK
    5. Check Pelles version using JSON_HEDLEY_PELLES_VERSION_CHECK
}$$

$$ NoReturnAttribute {
    1. Define JSON_HEDLEY_NO_RETURN based on compiler version checks
    2. Use __declspec(noreturn) for MSVC and Pelles
    3. Use _Pragma("FUNC_NEVER_RETURNS;") for TI CL6X in C++ mode
    4. Use __attribute__((noreturn)) for CompCert
    5. Default to empty definition
}$$

$$ NoEscapeAttribute {
    1. Check if JSON_HEDLEY_NO_ESCAPE is already defined
    2. Define JSON_HEDLEY_NO_ESCAPE using __attribute__((__noescape__)) if supported
    3. Default to empty definition
}$$

$$ AssumeMacro {
    1. Check if JSON_HEDLEY_ASSUME is already defined
    2. Define JSON_HEDLEY_ASSUME using compiler-specific intrinsics
    3. Use __assume for MSVC and Intel
    4. Use __builtin_assume for GCC and Clang
    5. Use std::_nassert or _nassert for TI compilers
    6. Default to casting expression to void
}$$

$$ UnreachableMacro {
    1. Check if JSON_HEDLEY_UNREACHABLE is already defined
    2. Define JSON_HEDLEY_UNREACHABLE using compiler-specific intrinsics
    3. Use __builtin_unreachable for GCC, Clang, and other supported compilers
    4. Use JSON_HEDLEY_ASSUME(0) as fallback
    5. Define JSON_HEDLEY_UNREACHABLE_RETURN using JSON_HEDLEY_UNREACHABLE or return statement
}$$

$$ NonNullAttribute {
    1. Check if JSON_HEDLEY_NON_NULL is already defined
    2. Define JSON_HEDLEY_NON_NULL using __attribute__((__nonnull__)) if supported
    3. Default to empty definition
}$$

$$ PrintfFormatAttribute {
    1. Check if JSON_HEDLEY_PRINTF_FORMAT is already defined
    2. Define JSON_HEDLEY_PRINTF_FORMAT using compiler-specific attributes
    3. Use __attribute__((__format__)) for GCC, Clang, and other supported compilers
    4. Use __declspec(vaformat) for Pelles
    5. Default to empty definition
}$$

$$ ConstexprMacro {
    1. Check if JSON_HEDLEY_CONSTEXPR is already defined
    2. Define JSON_HEDLEY_CONSTEXPR using constexpr in C++11 or later
    3. Default to empty definition
}$$

$$ PredictMacros {
    1. Check if prediction macros are already defined
    2. Define JSON_HEDLEY_PREDICT, JSON_HEDLEY_LIKELY, JSON_HEDLEY_UNLIKELY using compiler-specific intrinsics
    3. Use __builtin_expect_with_probability or __builtin_expect for supported compilers
    4. Default to simple expression evaluation
}$$

$$MallocAttribute {
    1. Check if JSON_HEDLEY_MALLOC is already defined
    2. Define JSON_HEDLEY_MALLOC using __attribute__((__malloc__)) if supported
    3. Use compiler-specific alternatives for other compilers
    4. Default to empty definition
}$$

$$ PureAttribute {
    1. Check if JSON_HEDLEY_PURE is already defined
    2. Define JSON_HEDLEY_PURE using __attribute__((__pure__)) if supported
    3. Use compiler-specific alternatives for other compilers
    4. Default to empty definition
}$$

$$ ConstAttribute {
    1. Check if JSON_HEDLEY_CONST is already defined
    2. Define JSON_HEDLEY_CONST using __attribute__((__const__)) if supported
    3. Use compiler-specific alternatives for other compilers
    4. Default to JSON_HEDLEY_PURE
}$$

$$ RestrictMacro {
    1. Check if JSON_HEDLEY_RESTRICT is already defined
    2. Define JSON_HEDLEY_RESTRICT using restrict or __restrict based on compiler and language
    3. Default to empty definition
}$$

$$ InlineMacro {
    1. Check if JSON_HEDLEY_INLINE is already defined
    2. Define JSON_HEDLEY_INLINE using inline or compiler-specific keywords
    3. Default to empty definition
}$$

$$ AlwaysInlineAttribute {
    1. Check if JSON_HEDLEY_ALWAYS_INLINE is already defined
    2. Define JSON_HEDLEY_ALWAYS_INLINE using __attribute__((__always_inline__)) or compiler-specific alternatives
    3. Default to JSON_HEDLEY_INLINE
}$$

$$ NeverInlineAttribute {
    1. Check if JSON_HEDLEY_NEVER_INLINE is already defined
    2. Define JSON_HEDLEY_NEVER_INLINE using __attribute__((__noinline__)) or compiler-specific alternatives
    3. Default to empty definition
}$$

$$ VisibilityMacros {
    1. Define JSON_HEDLEY_PRIVATE, JSON_HEDLEY_PUBLIC, and JSON_HEDLEY_IMPORT based on platform and compiler
    2. Use __declspec(dllexport) and __declspec(dllimport) for Windows
    3. Use __attribute__((__visibility__("hidden"))) and __attribute__((__visibility__("default"))) for supported compilers
    4. Default to empty definitions
}$$
$$ MacroDefinitions {
    1. Define JSON_HEDLEY_NO_THROW based on compiler attributes or directives.
    2. Define JSON_HEDLEY_FALL_THROUGH based on compiler attributes or directives.
    3. Define JSON_HEDLEY_RETURNS_NON_NULL based on compiler attributes or directives.
    4. Define JSON_HEDLEY_ARRAY_PARAM based on compiler and language standards.
    5. Define JSON_HEDLEY_IS_CONSTANT and JSON_HEDLEY_REQUIRE_CONSTEXPR based on compiler builtins and language standards.
    6. Define JSON_HEDLEY_BEGIN_C_DECLS, JSON_HEDLEY_END_C_DECLS, and JSON_HEDLEY_C_DECL for C++ and C compatibility.
    7. Define JSON_HEDLEY_STATIC_ASSERT based on compiler and language standards.
    8. Define JSON_HEDLEY_NULL based on language standards and compiler definitions.
    9. Define JSON_HEDLEY_MESSAGE and JSON_HEDLEY_WARNING for compiler-specific message and warning pragmas.
    10. Define JSON_HEDLEY_REQUIRE and JSON_HEDLEY_REQUIRE_MSG for compiler-specific requirement diagnostics.
    11. Define JSON_HEDLEY_FLAGS and JSON_HEDLEY_FLAGS_CAST for flag enum attributes and casting.
    12. Define JSON_HEDLEY_EMPTY_BASES for empty base class optimization.
    13. Define deprecated macros for backward compatibility.
    14. Exclude unsupported compilers and detect C++ language standard.
    15. Define filesystem and experimental filesystem support based on compiler and language standards.
    16. Define three-way comparison and ranges support based on compiler and language standards.
    17. Define static RTTI support based on compiler definitions.
    18. Define inline variable support based on C++17 availability.
}$$

