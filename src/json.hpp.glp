$$ CalcBSONElementSize -> CalcBSONEntryHeaderSize, CalcBSONObjectSize, CalcBSONArraySize, CalcBSONBinarySize, CalcBSONIntegerSize, CalcBSONUnsignedSize, CalcBSONStringSize {
