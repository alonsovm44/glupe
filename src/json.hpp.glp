$$ FindLargestPow10 {
    1. Check if n >= 1000000000
    2. Check if n >= 100000000
    3. Check if n >= 10000000
    4. Check if n >= 1000000
    5. Check if n >= 100000
    6. Check if n >= 10000
    7. Check if n >= 1000
    8. Check if n >= 100
    9. Check if n >= 10
    10. Return pow10 and k
}$$

$$ Grisu2Round -> Includes, Constants {
    1. Assert len >= 1
    2. Assert dist <= delta
    3. Assert rest <= delta
    4. Assert ten_k > 0
    5. While rest < dist and delta - rest >= ten_k and (rest + ten_k < dist or dist - rest > rest + ten_k - dist)
        5.1 Decrement buf[len - 1]
        5.2 Increment rest by ten_k
}$$

$$ Grisu2DigitGen -> Includes, Constants, FindLargestPow10, Grisu2Round {
    1. Assert M_plus.e >= kAlpha
    2. Assert M_plus.e <= kGamma
    3. Calculate delta and dist
    4. Split M+ into p1 and p2
    5. Generate digits of integral part
    6. Generate digits of fractional part
    7. Call Grisu2Round
}$$

$$ GetCachedPowerForBinaryExponent -> ComputeCachedPower {
    1. Call ComputeCachedPower
}$$

$$ Grisu2 -> Includes, Constants, GetCachedPowerForBinaryExponent, Grisu2DigitGen {
    1. Scale v, m_minus, and m_plus
    2. Calculate w, w_minus, and w_plus
    3. Adjust M_minus and M_plus
    4. Call Grisu2DigitGen
}$$

