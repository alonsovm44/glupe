$$ABSTRACT FlexBisonInterface {
    1. Provide yyparse function for parsing.
    2. Expose yylineno for line counter resets.
    3. Define YY_BUFFER_STATE for string scanning.
}$$

$$ GlobalsAndConstants {
    extern int yyparse(ProgramNode** root);
    extern int yylineno;
    typedef struct yy_buffer_state *YY_BUFFER_STATE;
    extern YY_BUFFER_STATE yy_scan_string(const char *str);
    extern void yy_delete_buffer(YY_BUFFER_STATE buffer);
}$$

$$ DecomentGlupeSyntax -> FlexBisonInterface {
    1. Process block comments: /* ... */.
    2. Process line comments: // ....
    3. Process Glupe block comments: %{ ... }%.
    4. Process Glupe line comments: % ....
    5. Return processed code with Glupe syntax extracted.
}$$

$$ ResolveImports -> DecomentGlupeSyntax {
    1. Read code line by line.
    2. Process IMPORT directives.
    3. Handle local modifications within IMPORT blocks.
    4. Recursively resolve imports with cycle detection.
    5. Return processed code with imports resolved.
}$$

$$ StripAllContainers -> FlexBisonInterface {
    1. Parse code into AST.
    2. Rebuild code ignoring ContainerNodes and VariableNodes.
    3. Return stripped code.
}$$

$$ ValidateContainers -> FlexBisonInterface {
    1. Parse code into AST.
    2. Validate container names for duplicates.
    3. Check for active (non-abstract) containers.
    4. Return validation result.
}$$

$$ ProcessExports {
    1. Clean code by stripping all containers.
    2. Process EXPORT directives.
    3. Write exported code to specified files.
    4. Return remaining unexported code.
}$$

$$ ExtractDependencies {
    1. Parse code for dependency warnings and includes.
    2. Return set of extracted dependencies.
}$$

$$ PreFlightCheck {
    1. Check if dependencies are empty.
    2. Verify dependencies locally by compiling a temporary file.
    3. Return check result.
}$$

$$ SplitSourceCode {
    1. Split code into chunks based on line count and brace balance.
    2. Return vector of code chunks.
}$$
$$ sliceSourceCodeAST -> {
    1. Initialize parser with language.
    2. If language not set, fallback to heuristic split.
    3. Parse code into AST tree.
    4. Iterate through top-level nodes.
    5. Group nodes into chunks based on type.
    6. Return chunks as vector of strings.
}$$

$$ extractSignatures -> {
    1. Read code line by line.
    2. Trim leading whitespace.
    3. Skip comments.
    4. Collect signatures for includes, typedefs, classes, structs, enums, and functions.
    5. Return collected signatures as string.
}$$

$$ stripMetadata -> {
    1. Find META_START and META_END markers.
    2. If found, remove metadata block from code.
    3. Return sanitized code.
}$$

$$ showMetadata -> {
    1. Check if file exists.
    2. Read file content.
    3. Extract metadata block.
    4. Parse JSON metadata.
    5. Extract dependencies.
    6. Display metadata and dependencies.
}$$

$$ sanitize_container_syntax -> {
    1. Fix malformed container starts and ends.
    2. Flatten multiline inline containers.
    3. Fix detached block closers.
    4. Fix block containers.
    5. Remove stray single .
    6. Return sanitized code.
}$$

$$ parseBlueprint -> {
    1. Initialize blueprint entries.
    2. Parse full context line by line.
    3. Skip internal markers.
    4. Extract filename and content for each EXPORT block.
    5. Return vector of blueprint entries.
}$$

$$ get_refine_query -> {
    1. Return Tree-sitter query based on language ID.
}$$

$$ TSASTParser -> {
    1. Set language for parser.
    2. Parse string into AST tree.
}$$

$$ TSASTTree -> {
    1. Store root node of AST tree.
}$$

$$ TSASTNode -> {
    1. Access child nodes.
    2. Get node type and text.
}$$

$$ BlueprintEntry -> {
    1. Store filename and content.
}$$

$$ fs -> {
    1. Check if file exists.
}$$

$$ json -> {
    1. Parse JSON string.
    2. Dump JSON to string.
}$$

$$ extractDependencies -> {
    1. Extract dependencies from code.
}$$
