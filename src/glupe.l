%{
#include "ast.hpp"
#include "glupe.tab.h" // This will be generated by Bison in the next step
#include <string>

/* Workaround for C++17 deprecated register keyword in Flex */
#define register
%}

%option noyywrap
%option yylineno
%option nounput

/* Exclusive states to cleanly separate Target Code from Glupe Syntax */
%x VAR_ID
%x VAR_VALUE
%x BLOCK_HEADER
%x INLINE_HEADER
%x BLOCK_INTENT
%x INLINE_INTENT

%%

<INITIAL>{
    /* String Literals */
    \"(\\.|[^"\\])*\"          { yylval.str = new std::string(yytext); return T_RAW_CODE; }
    \'(\\.|[^'\\])*\'          { yylval.str = new std::string(yytext); return T_RAW_CODE; }
    \`(\\.|[^`\\])*\`          { yylval.str = new std::string(yytext); return T_RAW_CODE; }
    
    /* Comments */
    "//"[^\n]*                 { yylval.str = new std::string(yytext); return T_RAW_CODE; }
    "/*"([^*]|\*+[^*/])*\*+"/" { yylval.str = new std::string(yytext); return T_RAW_CODE; }
    "#"[^\n]*                  { yylval.str = new std::string(yytext); return T_RAW_CODE; }

    "$$:"                   { BEGIN(VAR_ID); return T_PERSISTENT_VAR_START; }
    "$CONST:"               { BEGIN(VAR_ID); return T_CONST_VAR_START; }
    "$:"                    { BEGIN(VAR_ID); return T_EPHEMERAL_VAR_START; }

    "$$"                    { BEGIN(BLOCK_HEADER); return T_BLOCK_START; }
    "$"                     { BEGIN(INLINE_HEADER); return T_INLINE_START; }

    [^\$\"\'/\#\`]+         { yylval.str = new std::string(yytext); return T_RAW_CODE; }
    .                       { yylval.str = new std::string(yytext); return T_RAW_CODE; }
}

<VAR_ID>{
    [ \t]+                  { /* skip whitespace */ }
    [a-zA-Z_][a-zA-Z0-9_]*  { BEGIN(VAR_VALUE); yylval.str = new std::string(yytext); return T_IDENTIFIER; }
}

<VAR_VALUE>{
    [^\n\r]+                { 
                              std::string val(yytext);
                              size_t first = val.find_first_not_of(" \t");
                              /* Make the arrow operator optional */
                              if (first != std::string::npos && val.substr(first, 2) == "->") {
                                  first += 2;
                              }
                              first = val.find_first_not_of(" \t", first);
                              size_t last = val.find_last_not_of(" \t");
                              if(first != std::string::npos && last != std::string::npos && first <= last)
                                  val = val.substr(first, (last - first + 1));
                              else
                                  val = "";
                              yylval.str = new std::string(val); 
                              return T_VAR_VALUE; 
                            }
    \n|\r\n                 { BEGIN(INITIAL); return T_NEWLINE; }
}

<BLOCK_HEADER,INLINE_HEADER>{
    [ \t\r\n]+              { /* skip whitespace */ }
    "ABSTRACT"              { return T_ABSTRACT; }
    "->"                    { return T_ARROW; }
    ","                     { return T_COMMA; }
    "("                     { return T_LPAREN; }
    ")"                     { return T_RPAREN; }
    "+"                     { return T_PLUS; }
    "-"                     { return T_MINUS; }
    "*"                     { return T_STAR; }
    "/"                     { return T_SLASH; }
    "^"                     { return T_CARET; }
    [a-zA-Z_][a-zA-Z0-9_]*  { yylval.str = new std::string(yytext); return T_IDENTIFIER; }
    [0-9]+                  { yylval.str = new std::string(yytext); return T_NUMBER; }
    \"[^\"]*\"              { 
                              std::string s(yytext); 
                              yylval.str = new std::string(s.substr(1, s.length() - 2)); 
                              return T_STRING_LITERAL; 
                            }
}

<BLOCK_HEADER>"{"           { BEGIN(BLOCK_INTENT); return T_LBRACE; }
<INLINE_HEADER>"{"          { BEGIN(INLINE_INTENT); return T_LBRACE; }

<BLOCK_INTENT>{
    "}$$"                   { BEGIN(INITIAL); return T_BLOCK_END; }
    [^}]+                   { yylval.str = new std::string(yytext); return T_INTENT_TEXT; }
    "}"                     { yylval.str = new std::string(yytext); return T_INTENT_TEXT; } /* Catch-all for internal braces */
}

<INLINE_INTENT>{
    "}$"                    { BEGIN(INITIAL); return T_INLINE_END; }
    [^}]+                   { yylval.str = new std::string(yytext); return T_INTENT_TEXT; }
    "}"                     { yylval.str = new std::string(yytext); return T_INTENT_TEXT; } /* Catch-all for internal braces */
}

%%

/* Flex automatically generates the 'yylex' function. We don't need additional C code here yet. */