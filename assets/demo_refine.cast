[2.450, "o", "#include <stdio.h>\r\n\r\nint do_math(int a, int b) {\r\n    int r = 0;\r\nloop:\r\n    if (b == 0) goto end;\r\n    r += a;\r\n    b--;\r\n    goto loop;\r\nend:\r\n    return r;\r\n}\r\n"]
